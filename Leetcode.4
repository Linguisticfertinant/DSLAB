//remove elements from array
#include <iostream>
#include <vector>
using namespace std;

int main() {
    int n, val, k = 0;

    cin >> n;
    vector<int> nums(n);

    for(int i = 0; i < n; i++)
        cin >> nums[i];

    cin >> val;

    for(int i = 0; i < n; i++) {
        if(nums[i] != val)
            nums[k++] = nums[i];
    }

    cout << k << endl;

    for(int i = 0; i < k; i++)
        cout << nums[i] << " ";

    return 0;
}
